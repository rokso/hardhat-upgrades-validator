{
  "name": "hardhat-upgrades-validator",
  "version": "0.1.0-alpha.3",
  "description": "Hardhat v3 plugin to validate storage layout compatibility when upgrading proxy contracts managed by hardhat-deploy v2",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/validate-proxy.d.ts",
      "import": "./dist/proxy/validate-proxy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "pretest": "pnpm fixtures",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm lint && pnpm test",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "fixtures": "pnpm build && cd test/fixtures && npx hardhat compile"
  },
  "packageManager": "pnpm@9.0.0",
  "peerDependencies": {
    "hardhat": "^3.6.0"
  },
  "peerDependenciesMeta": {
    "hardhat": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "hardhat": "^3.18.1",
    "prettier": "^3.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "hardhat",
    "hardhat-plugin",
    "hardhat-deploy",
    "ethereum",
    "solidity",
    "upgradeable",
    "proxy",
    "storage-layout",
    "upgrade-safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokso/hardhat-upgrades-validator.git"
  },
  "dependencies": {
    "@nomicfoundation/slang": "^1.3.4",
    "@openzeppelin/upgrades-core": "^1.46.0",
    "chalk": "^6.0.1",
    "slotdiff": "^0.3.1",
    "solidity-ast": "^0.4.62"
  }
}
